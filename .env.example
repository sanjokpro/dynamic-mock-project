# Backend environment (Spring Boot reads OS env vars; docker-compose reads this file).
# Copy to .env and run `docker compose --env-file .env up` (add .env to .gitignore first — see below), or just export the variables before running.

# Admin API key validated by ApiKeyAuthFilter on /api/** (property: app.api.key).
# Retained for headless/script integrations. The browser UI now authenticates with JWT.
API_KEY=default-dev-key

# ── JWT Authentication ─────────────────────────────────────────────────────────
# REQUIRED in production: generate with: openssl rand -hex 32
# APP_AUTH_JWT_SECRET=<replace-with-a-32-plus-character-random-string>
APP_AUTH_JWT_SECRET=local-dev-insecure-secret-must-be-changed-in-prod-minimum-32-chars
APP_AUTH_JWT_EXPIRY_HOURS=8

# ── Initial Administrator Account ─────────────────────────────────────────────
# Used only when the MongoDB 'users' collection is empty on first boot.
ADMIN_USERNAME=admin
# REQUIRED in production: change from default!
ADMIN_PASSWORD=admin

# ── Registration Gate ──────────────────────────────────────────────────────────
# Set to true to allow self-service user registration via POST /api/auth/register.
APP_AUTH_ALLOW_REGISTRATION=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for /api/** cross-origin requests.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# When running E2E tests against the NGINX-hardened prod stack on port 80, set this:
# PLAYWRIGHT_BASE_URL=http://localhost
