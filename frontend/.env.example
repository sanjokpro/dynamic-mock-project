# Copy to .env.local for local development (.env.local is gitignored).

# Server-side backend origin, used by next.config.ts rewrites (the /api proxy)
# and the SSR branch of the isomorphic axios client in src/lib/apiClient.ts.
# Locally you can leave it unset (defaults to http://localhost:8080).
# In docker-compose this must be the service name: http://mock-server:8080.
# BACKEND_URL=http://localhost:8080

# API key attached as the X-API-KEY header by the browser client.
# Must match the backend's app.api.key (env: API_KEY). This value is inlined
# into the client bundle at build time — never use a real secret here.
NEXT_PUBLIC_API_KEY=default-dev-key

# Optional explicit SockJS endpoint for the live traffic console (use an
# http(s):// URL — SockJS negotiates the websocket upgrade itself). When unset:
#   production  -> window.location.origin + /ws-traffic
#   development -> http://localhost:8080/ws-traffic
# NEXT_PUBLIC_WS_URL=http://localhost:8080/ws-traffic
